# -------------------------------------------------------------------
# APP CONFIG
# -------------------------------------------------------------------

NODE_ENV=development
PORT=3000
APP_NAME=MedRevisionAPI
APP_URL=http://localhost:3000

# Timezone (important for streaks / scheduling)
TZ=Africa/Algiers


# -------------------------------------------------------------------
# DATABASE (POSTGRESQL + PRISMA)
# -------------------------------------------------------------------

DATABASE_URL="postgresql://postgres:password@localhost:5432/med_revision_db?schema=public"
DATABASE_USER="username"
DATABASE_PASSWORD="password"
DATABASE_NAME="mydb"
DATABASE_HOST="localhost"
DATABASE_PORT=3306

# -------------------------------------------------------------------
# REDIS
# -------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379


# -------------------------------------------------------------------
# AUTH (JWT)
# -------------------------------------------------------------------

JWT_SECRET=super_long_random_secret_key_change_me
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=another_super_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d


JWT_RESET_PASSWORD_SECRET=yet_another_super_long_random_secret
JWT_RESET_PASSWORD_EXPIRES_IN=10m

SESSION_SECRET=another_super_long_random_secret_for_sessions

# Cookie settings (if you use cookies later)
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax


# -------------------------------------------------------------------
# REDIS
# -------------------------------------------------------------------

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=


# -------------------------------------------------------------------
# BCRYPT
# -------------------------------------------------------------------

BCRYPT_SALT_ROUNDS=10


# -------------------------------------------------------------------
# RATE LIMITING
# -------------------------------------------------------------------

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120


# -------------------------------------------------------------------
# CORS
# -------------------------------------------------------------------

CORS_ORIGIN=http://localhost:5173


# -------------------------------------------------------------------
# FILE UPLOADS (future PDF / OCR system)
# -------------------------------------------------------------------

MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads


# -------------------------------------------------------------------
# LOGGING
# -------------------------------------------------------------------

LOG_LEVEL=debug


# -------------------------------------------------------------------
# OPTIONAL EXTERNAL SERVICES (future)
# -------------------------------------------------------------------

# Email service (for password reset)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MedRevision <no-reply@medrevision.com>"

# Cloud storage (images, PDFs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# -------------------------------------------------------------------
# FEATURE FLAGS (VERY USEFUL FOR MVP)
# -------------------------------------------------------------------

FEATURE_REGISTRATION=true
FEATURE_EXAMS=true
FEATURE_SPACED_REPETITION=true
FEATURE_ANALYTICS=true
FEATURE_BETA_MODE=false