model Module {
    id           String    @id @default(uuid())
    name         String    @db.VarChar(255)
    illustration String?   @db.VarChar(255)
    description  String?   @db.VarChar(255)
    chapters     Chapter[]
    year         Year      @relation(fields: [year_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
    year_id      String
    created_at   DateTime  @default(now())
    updated_at   DateTime  @updatedAt
    deleted_at   DateTime?

    @@unique([name, year_id], map: "Module_name_year_id_faculty_id_key")
    @@index([year_id])
}

model Chapter {
    id         Int       @id @default(autoincrement())
    title      String    @db.VarChar(255)
    module     Module    @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
    // questions Question[]
    module_id  String
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    deleted_at DateTime?

    @@unique([title, module_id])
    @@index([module_id])
}
